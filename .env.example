# Copy to `.env` to override. docker-compose.yml supplies a working default for every
# one of these, so `docker compose up` works with NO .env file present.

# ---- database -------------------------------------------------------------------
POSTGRES_USER=peblo
POSTGRES_PASSWORD=peblo
POSTGRES_DB=peblo
# The API's connection string. In compose this is built from the three values above.
DATABASE_URL=postgresql+psycopg://peblo:peblo@db:5432/peblo

# ---- auth -----------------------------------------------------------------------
# Signs the JWTs. MUST be replaced in any real deployment — anyone holding this value
# can mint a valid admin token.
JWT_SECRET=dev-only-not-a-real-secret

# ---- storage --------------------------------------------------------------------
# 'local' (disk, the default) or 'r2' (Cloudflare R2). Selects the Storage class; no
# other code changes when switching.
STORAGE_BACKEND=local
STORAGE_ROOT=/storage

# Only read when STORAGE_BACKEND=r2.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket or custom domain that serves artwork directly, bypassing the API.
R2_PUBLIC_BASE_URL=

# ---- seeding --------------------------------------------------------------------
SEED_ON_START=true
SEED_DIR=/data/seed
# Publishes once after seeding so the viewer has content immediately on first boot.
AUTOPUBLISH_ON_SEED=true

# ---- seeded accounts ------------------------------------------------------------
# Take-home convenience. A real system would not create accounts from env vars.
ADMIN_EMAIL=admin@peblo.test
ADMIN_PASSWORD=admin123
EDITOR_EMAIL=editor@peblo.test
EDITOR_PASSWORD=editor123

# ---- ports (host side) ----------------------------------------------------------
API_PORT=8000
CMS_PORT=3000
VIEWER_PORT=3001
DB_PORT=5432

# ---- frontend dev only ----------------------------------------------------------
# Used by `npm run dev` outside containers; behind nginx the apps call /api directly.
VITE_API_URL=http://localhost:8000
